<form class="tsru-talent-point-config">
  <p class="notes">This font is used universally for Talent Point numbers in the floating Talent Points panel and above character HP bars.</p>
  <div class="form-group">
    <label>Talent Point Number Font</label>
    <div class="form-fields tsru-file-control">
      <input type="text" name="numberFontFile" value="{{config.numberFontFile}}" placeholder="Choose TTF, OTF, WOFF, or WOFF2">
      <button type="button" class="file-picker" data-type="any" data-target="numberFontFile" title="Browse font files"><i class="fas fa-file-import"></i></button>
    </div>
    <p class="notes">Leave empty to use the default interface font.</p>
  </div>
  <footer class="sheet-footer flexrow">
    <button type="submit"><i class="fas fa-save"></i> Save Talent Appearance</button>
  </footer>
</form>
