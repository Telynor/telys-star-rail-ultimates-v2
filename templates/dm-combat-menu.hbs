<form class="tsru-dm-combat-menu">
  <nav class="tsru-dm-tabs" aria-label="Combat controls">
    {{#each tabs}}<button type="button" class="{{#if active}}active{{/if}}" data-dm-tab="{{id}}" aria-selected="{{active}}"><i class="{{icon}}"></i><span>{{label}}</span></button>{{/each}}
  </nav>
  <section class="tsru-dm-scroll" data-dm-scroll>
    {{#if talentsTab}}
      {{#each talentGroups}}<h3 class="tsru-dm-group-heading">{{label}}</h3>{{#each talents}}<article class="tsru-dm-card"><div class="tsru-dm-identity"><img src="{{image}}" alt=""><strong>{{name}}</strong></div><p title="{{description}}">{{description}}</p><div class="tsru-dm-actions"><button type="button" data-dm-talent-popup="{{id}}">View Talent</button>{{#if hasPoints}}<button type="button" data-dm-talent="{{id}}" data-delta="-1" {{#unless eligible}}disabled title="Requires a token in combat"{{/unless}}>−</button><b>{{points}} / {{maximum}}</b><button type="button" data-dm-talent="{{id}}" data-delta="1" {{#unless eligible}}disabled title="Requires a token in combat"{{/unless}}>+</button>{{/if}}</div></article>{{/each}}{{else}}<p class="tsru-dm-empty">No talents for combatants on this scene.</p>{{/each}}
    {{/if}}
    {{#if weaknessesTab}}
      {{#each enemies}}<article class="tsru-dm-card"><div class="tsru-dm-identity"><img src="{{image}}" alt=""><strong>{{name}}</strong><button type="button" data-dm-weak-lock="{{uuid}}" title="{{#if locked}}Unlock weakness controls{{else}}Lock weakness controls{{/if}}"><i class="fas {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button></div><div class="tsru-dm-elements">{{#each elements}}<button type="button" data-dm-element="{{../uuid}}" data-element="{{id}}" class="{{#if active}}active{{/if}}" title="{{name}}{{#if permanent}} (base weakness){{/if}}" {{#if ../locked}}disabled{{/if}}><img src="{{icon}}" alt=""><span>{{name}}</span></button>{{/each}}</div><div class="tsru-dm-actions"><button type="button" data-dm-mode="{{uuid}}" data-mode="all" {{#if locked}}disabled{{/if}}>All</button><button type="button" data-dm-mode="{{uuid}}" data-mode="none" {{#if locked}}disabled{{/if}}>None</button><button type="button" data-dm-reset="{{uuid}}" {{#if locked}}disabled{{/if}}>Reset</button><small>{{modeLabel}}</small></div></article>{{else}}<p class="tsru-dm-empty">No enemies on this scene.</p>{{/each}}
    {{/if}}
    {{#if stancesTab}}
      {{#each stances}}<article class="tsru-dm-card"><div class="tsru-dm-identity"><img src="{{image}}" alt=""><strong>{{name}}</strong><span class="tsru-dm-status">{{#if active}}Enhanced{{else}}Normal{{/if}}</span></div><div class="tsru-dm-actions"><button type="button" data-dm-stance="{{id}}">Switch to {{#if active}}Normal{{else}}Enhanced{{/if}}</button></div></article>{{else}}<p class="tsru-dm-empty">Enable Enhanced Stance on a character sheet to show it here.</p>{{/each}}
    {{/if}}
    {{#if phasesTab}}
      {{#each bosses}}<article class="tsru-dm-card"><div class="tsru-dm-identity"><img src="{{image}}" alt=""><strong>{{name}}</strong><span class="tsru-dm-status">Phase {{current}} / {{total}}</span></div><div class="tsru-dm-actions">{{#each phases}}<button type="button" data-dm-phase="{{../id}}" data-phase="{{number}}" class="{{#if active}}active{{/if}}">Phase {{number}}</button>{{/each}}</div></article>{{else}}<p class="tsru-dm-empty">No active multi-phase bosses in combat.</p>{{/each}}
    {{/if}}
  </section>
  <footer class="tsru-dm-footer"><div class="tsru-dm-resources"><div><button type="button" data-dm-resource="punchline" data-delta="-1">−</button><span>Punchline <b data-dm-value="punchline">{{punchline}}</b></span><button type="button" data-dm-resource="punchline" data-delta="1">+</button></div><div><button type="button" data-dm-resource="skill" data-delta="-1">−</button><span>Skill Points <b data-dm-value="skill">{{skillPoints}}</b></span><button type="button" data-dm-resource="skill" data-delta="1">+</button></div></div><div class="tsru-dm-turns"><button type="button" data-dm-turn="previous" {{#unless hasCombat}}disabled{{/unless}}>Previous Turn</button><div><button type="button" data-dm-advance {{#unless hasCombat}}disabled{{/unless}}>Action Advance…</button><button type="button" data-dm-end {{#unless hasCombat}}disabled{{/unless}}>End Combat</button></div><button type="button" data-dm-turn="next" {{#unless hasCombat}}disabled{{/unless}}>Next Turn</button></div></footer>
</form>
