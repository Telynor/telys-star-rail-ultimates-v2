<form class="tsru-quest-manager-form tsru-mission-gm-browser">
  <header><div><h2>Mission Manager</h2><p>{{total}} missions · {{hiddenCount}} hidden · {{archivedCount}} archived</p></div><button type="button" data-new-quest><i class="fas fa-plus"></i> New Mission</button></header>
  <div class="tsru-mission-gm-tools"><input type="search" data-mission-search placeholder="Search missions, places, and types"><select data-manager-filter><option value="all">All missions</option><option value="active">Active</option><option value="hidden">Hidden</option><option value="complete">Complete · rewards pending</option><option value="archived">Archived</option></select></div>
  <div class="tsru-mission-gm-groups">{{#each groups}}<section data-manager-group><h3><img src="{{this.type.icon}}" alt="">{{this.type.name}}</h3><div class="tsru-mission-gm-grid">{{#each this.missions}}<button type="button" data-manager-card data-manager-search-text="{{this.searchText}}" data-manager-status="{{this.managerStatus}}" data-open-manager-quest="{{this.id}}" class="tsru-mission-gm-card {{#if this.cardBackground}}has-art{{/if}}"><span class="tsru-mission-gm-art" {{#if this.cardBackground}}style="background-image:url('{{this.cardBackground}}')"{{/if}}></span><span class="tsru-mission-gm-info"><img src="{{this.typeIcon}}" alt=""><strong>{{this.title}}</strong><small>{{this.location}}</small><em>{{#if this.archived}}Archived{{else}}{{#if this.hidden}}Hidden · Ready to activate{{else}}{{#if (eq this.status "complete")}}Complete · Rewards pending{{else}}Active{{/if}}{{/if}}{{/if}}</em></span></button>{{/each}}</div></section>{{else}}<div class="tsru-empty-state"><i class="fas fa-clipboard-list"></i><p>No missions yet. Create one to prepare it privately.</p></div>{{/each}}</div>
</form>
