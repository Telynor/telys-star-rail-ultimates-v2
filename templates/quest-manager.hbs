<form class="tsru-quest-manager-form">
  <header><div><h2>Mission Manager</h2><p>Only GMs can edit missions, assignments, hidden objectives, stages, and rewards.</p></div><button type="button" data-new-quest><i class="fas fa-plus"></i> New Mission</button></header>
  <div class="tsru-mission-browser"><label>Search missions<input type="search" data-mission-search value="{{search}}" placeholder="Search title, location, description, rewards"></label><div class="tsru-mission-browser-list">{{#each quests}}<button type="button" data-select-manager-quest="{{this.id}}" data-manager-search-text="{{this.searchText}}" class="{{#if (eq this.id ../selectedQuest.id)}}active{{/if}}"><strong>{{this.title}}</strong><small>{{this.location}} · {{this.status}}</small></button>{{else}}<p>No missions yet. Create one above.</p>{{/each}}<p data-no-search-results hidden>No matching missions.</p></div></div>
  <div class="tsru-quest-editor-list">
  {{#if selectedQuest}}{{#with selectedQuest}}<article class="tsru-quest-editor-card" data-quest-id="{{this.id}}">
    <header><input class="tsru-quest-title-input" data-quest-field="title" value="{{this.title}}"><select data-quest-field="typeId">{{#each this.typeOptions}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}</select><span class="status {{this.status}}">{{this.status}}</span><button type="button" data-delete-quest="{{this.id}}"><i class="fas fa-trash"></i></button></header>
    <div class="tsru-quest-editor-grid">
      <label>Location<input data-quest-field="location" value="{{this.location}}"></label><label>Reward Mode<select data-quest-field="rewardMode"><option value="split" {{#if (eq this.rewardMode "split")}}selected{{/if}}>Split total evenly</option><option value="copy" {{#if (eq this.rewardMode "copy")}}selected{{/if}}>Full copy per assigned character</option></select></label>
      <label class="wide">Mission card image (optional; overrides the mission type background)<span class="tsru-file-control"><input data-quest-field="background" name="missionCardBackground" value="{{this.background}}" placeholder="Use mission type background"><button type="button" class="file-picker" data-type="image" data-target="missionCardBackground"><i class="fas fa-file-import"></i></button></span></label>
      <label class="wide">Description<textarea data-quest-field="description">{{this.description}}</textarea></label>
      <fieldset class="wide"><legend>Main Party — quick access</legend><div class="tsru-assignment-list">{{#each this.mainPartyActors}}<label><input type="checkbox" data-assignment value="{{this.id}}" {{checked this.assigned}}><img src="{{this.img}}"><span>{{this.name}}</span></label>{{else}}<em>No characters marked “Is in main party?” yet.</em>{{/each}}</div></fieldset>
      <fieldset class="wide"><legend>Other Player Characters</legend><div class="tsru-assignment-list">{{#each this.otherActors}}<label><input type="checkbox" data-assignment value="{{this.id}}" {{checked this.assigned}}><img src="{{this.img}}"><span>{{this.name}}</span></label>{{else}}<em>No other characters.</em>{{/each}}</div></fieldset>
      <fieldset class="wide"><legend>Current Stage</legend><div class="tsru-stage-head"><select data-quest-field="stageIndex">{{#each this.stages}}<option value="{{@index}}" {{#if (eq @index ../stageIndex)}}selected{{/if}}>{{this.title}}</option>{{/each}}</select><input data-stage-title value="{{this.currentStage.title}}" placeholder="Stage title"><button type="button" data-add-stage="{{this.id}}"><i class="fas fa-plus"></i> Add Stage</button><button type="button" data-add-objective="{{this.id}}"><i class="fas fa-plus"></i> Add Objective</button></div>
        <div class="tsru-objective-edit-list">{{#each this.currentStage.objectives}}<div data-objective-id="{{this.id}}"><input data-objective-field="text" value="{{this.text}}"><label><input type="checkbox" data-objective-field="hidden" {{checked this.hidden}}> Hidden</label><label><input type="checkbox" data-objective-field="revealed" {{checked this.revealed}}> Revealed</label><label><input type="checkbox" data-objective-field="complete" {{checked this.complete}}> Done</label><button type="button" data-remove-objective="{{this.id}}"><i class="fas fa-trash"></i></button></div>{{else}}<em>No objectives in this stage.</em>{{/each}}</div>
      </fieldset>
      <fieldset class="wide"><legend>Rewards</legend><div class="tsru-reward-drop"><i class="fas fa-hand-pointer"></i> Drag and drop Item documents here</div><div class="tsru-reward-edit-list">{{#each this.rewards}}<div class="tsru-reward-edit"><img src="{{this.img}}"><strong>{{this.name}}</strong><label>Qty <input type="number" min="1" value="{{this.quantity}}" data-reward-index="{{@index}}" data-reward-field="quantity"></label><label>Rarity <select data-reward-index="{{@index}}" data-reward-field="rarityId">{{#each ../rarityOptions}}<option value="{{this.id}}" {{#if (eq this.id ../rarityId)}}selected{{/if}}>{{this.name}}</option>{{/each}}</select></label><button type="button" data-remove-reward="{{@index}}"><i class="fas fa-trash"></i></button></div>{{/each}}</div></fieldset>
    </div>
    <footer><button type="button" data-save-quest="{{this.id}}"><i class="fas fa-save"></i> Save Mission</button><button type="button" data-complete-quest="{{this.id}}"><i class="fas fa-flag-checkered"></i> Mark Complete</button><button type="button" data-distribute-rewards="{{this.id}}" {{#if this.rewardsClaimed}}disabled{{/if}}><i class="fas fa-gift"></i> {{#if this.rewardsClaimed}}Rewards Distributed{{else}}Distribute Rewards{{/if}}</button></footer>
  </article>{{/with}}{{else}}<div class="tsru-empty-state"><i class="fas fa-clipboard-list"></i><p>Select a mission or create one.</p></div>{{/if}}
  </div>
</form>
