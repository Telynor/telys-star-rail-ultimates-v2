<section class="tsru-sheet-tab tab" data-group="primary" data-tab="tsru-ultimate">
  <div class="tsru-config-panel">
    <header class="tsru-config-heading"><div><h2><i class="fas fa-burst"></i> Character Settings</h2><p>Energy, Ultimate, artwork, combat UI, abilities, and encounter settings in one place.</p></div><span class="tsru-gm-badge">GM ONLY</span></header>

    <div class="tsru-config-section">
      <h3><i class="fas fa-users"></i> Party Membership</h3>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Is in the Main Party?</strong><small>Main-party turns finish before queued Ultimates begin. Unchecked DMPCs are not treated as allied turns.</small></span><input type="checkbox" name="mainParty" {{checked config.mainParty}}></div>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Trial Character?</strong><small>Displays a red Trial label above this character's Ultimate orb in the combat party HUD.</small></span><input type="checkbox" name="trialCharacter" {{checked config.trialCharacter}}></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Combat HUD portrait</strong><small>Artwork used for this character in the combat party lineup. You can also drop an image into the preview.</small></label><div class="tsru-file-control"><input type="text" class="tsru-drop-image" name="combatHudPortrait" value="{{config.combatHudPortrait}}" placeholder="Use actor portrait"><button type="button" class="file-picker" data-type="image" data-target="combatHudPortrait" title="Browse Files"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Combat HUD portrait crop</strong><small>Scale and reposition the artwork inside its portrait frame.</small></label><div class="tsru-position-control"><span>X</span><input type="number" name="combatHudPortraitX" min="0" max="100" value="{{config.combatHudPortraitX}}"><span>Y</span><input type="number" name="combatHudPortraitY" min="0" max="100" value="{{config.combatHudPortraitY}}"><span>Scale</span><input type="number" name="combatHudPortraitScale" min="50" max="300" value="{{config.combatHudPortraitScale}}"><span>%</span></div></div>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Invert portrait horizontally?</strong><small>Mirrors the combat HUD splash artwork without changing the uploaded file.</small></span><input type="checkbox" name="combatHudPortraitFlip" {{checked config.combatHudPortraitFlip}}></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Messenger profile picture</strong><small>Portrait shown when this character speaks in the HSR Messenger. Leave blank to use the actor portrait.</small></label><div class="tsru-file-control"><input type="text" class="tsru-drop-image" name="messagingPortrait" value="{{config.messagingPortrait}}" placeholder="Use actor portrait"><button type="button" class="file-picker" data-type="image" data-target="messagingPortrait" title="Browse Files"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Messenger portrait crop</strong><small>Adjust how the profile picture fits its circular chat frame.</small></label><div class="tsru-position-control"><span>X</span><input type="number" name="messagingPortraitX" min="0" max="100" value="{{config.messagingPortraitX}}"><span>Y</span><input type="number" name="messagingPortraitY" min="0" max="100" value="{{config.messagingPortraitY}}"><span>Scale</span><input type="number" name="messagingPortraitScale" min="50" max="400" value="{{config.messagingPortraitScale}}"><span>%</span></div></div>
      <div class="tsru-messaging-portrait-preview" data-messaging-portrait-preview><img src="{{#if config.messagingPortrait}}{{config.messagingPortrait}}{{else}}{{actor.img}}{{/if}}" alt="Messenger portrait"></div>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Override initiative frame color?</strong><small>Forces this PC's initiative frame and dot to use the selected color, even when the token is treated as an enemy.</small></span><input type="checkbox" name="carouselFrameColorOverride" {{checked config.carouselFrameColorOverride}}></div>
      <div class="tsru-field"><label><strong>Initiative frame color</strong><small>Inherits the selected reusable color from the global module settings.</small></label><select name="carouselFrameColorPreset">{{#each frameColors}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}</select></div>
      <button type="button" class="tsru-initiative-preview-toggle" data-action="open-initiative-portrait-editor"><i class="fas fa-up-right-from-square"></i> Edit Initiative Tracker Portrait</button>
      <div class="tsru-combat-hud-portrait-preview" data-tsru-combat-hud-preview></div>
      <p class="tsru-combat-hud-crop-help">Drop an image here. Drag the splash art to reposition it; use the mouse wheel over it to scale.</p>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Pause Energy Gain After Ultimate?</strong><small>Prevents this character from regaining Energy until the next combat round begins.</small></span><input type="checkbox" name="lockEnergyAfterUltimate" {{checked config.lockEnergyAfterUltimate}}></div>
    </div>

    <div class="tsru-config-section tsru-boss-config-section">
      <h3><i class="fas fa-skull"></i> Boss Encounter</h3>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Is Boss?</strong><small>While this actor is in active combat, display the shared boss HP bar and enable phase transitions.</small></span><input type="checkbox" name="isBoss" {{checked config.isBoss}}></div>
      <div class="tsru-field"><label><strong>Phase count</strong><small>Total phases represented by the glowing orbs.</small></label><select name="bossPhaseCount"><option value="1" {{#if bossPhase1}}selected{{/if}}>1</option><option value="2" {{#if bossPhase2}}selected{{/if}}>2</option><option value="3" {{#if bossPhase3}}selected{{/if}}>3</option></select></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Phase 2 actor</strong><small>Drag an Actor here. It replaces the current token when phase 1 reaches 0 HP.</small></label><div class="tsru-file-control"><input type="text" class="tsru-drop-actor" name="bossPhase2ActorUuid" value="{{config.bossPhase2ActorUuid}}" placeholder="Drop an Actor UUID"><button type="button" data-clear-boss-phase="bossPhase2ActorUuid" title="Clear"><i class="fas fa-xmark"></i></button></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Phase 2 token dimensions</strong><small>Width × height in grid units. Set either value to 0 to inherit that phase actor's prototype-token size.</small></label><div class="tsru-position-control"><span>X</span><input type="number" name="bossPhase2TokenWidth" min="0" max="20" step="0.5" value="{{config.bossPhase2TokenWidth}}"><span>Y</span><input type="number" name="bossPhase2TokenHeight" min="0" max="20" step="0.5" value="{{config.bossPhase2TokenHeight}}"></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Phase 3 actor</strong><small>Drag an Actor here. It replaces phase 2 when that phase reaches 0 HP.</small></label><div class="tsru-file-control"><input type="text" class="tsru-drop-actor" name="bossPhase3ActorUuid" value="{{config.bossPhase3ActorUuid}}" placeholder="Drop an Actor UUID"><button type="button" data-clear-boss-phase="bossPhase3ActorUuid" title="Clear"><i class="fas fa-xmark"></i></button></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Phase 3 token dimensions</strong><small>Width × height in grid units. Set either value to 0 to inherit that phase actor's prototype-token size.</small></label><div class="tsru-position-control"><span>X</span><input type="number" name="bossPhase3TokenWidth" min="0" max="20" step="0.5" value="{{config.bossPhase3TokenWidth}}"><span>Y</span><input type="number" name="bossPhase3TokenHeight" min="0" max="20" step="0.5" value="{{config.bossPhase3TokenHeight}}"></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>This phase's boss-bar portrait</strong><small>Each phase actor supplies its own portrait crop. Drop an image into the preview, drag to reposition, and use the mouse wheel to zoom.</small></label><div class="tsru-file-control"><input type="text" class="tsru-drop-image" name="bossHudPortrait" value="{{config.bossHudPortrait}}" placeholder="Use actor/token portrait"><button type="button" class="file-picker" data-type="image" data-target="bossHudPortrait" title="Browse Files"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Phase portrait crop</strong></label><div class="tsru-position-control"><span>X</span><input type="number" name="bossHudPortraitX" min="0" max="100" value="{{config.bossHudPortraitX}}"><span>Y</span><input type="number" name="bossHudPortraitY" min="0" max="100" value="{{config.bossHudPortraitY}}"><span>Scale</span><input type="number" name="bossHudPortraitScale" min="50" max="400" value="{{config.bossHudPortraitScale}}"><span>%</span></div></div>
      <div class="tsru-field"><label><strong>Boss bar width</strong><small>Inherited from phase 1 for the whole encounter.</small></label><input type="number" name="bossHudWidth" min="420" max="1400" value="{{config.bossHudWidth}}"></div>
      <div class="tsru-field"><label><strong>HP / Toughness height</strong></label><div class="tsru-position-control"><input type="number" name="bossHudHealthHeight" min="12" max="48" value="{{config.bossHudHealthHeight}}"><span>/</span><input type="number" name="bossHudToughnessHeight" min="4" max="24" value="{{config.bossHudToughnessHeight}}"></div></div>
      <div class="tsru-boss-designer-preview" data-tsru-boss-preview></div>
      <div class="tsru-field tsru-field-wide"><button type="button" data-action="show-boss-phase-control"><i class="fas fa-shuffle"></i> Show Floating Phase Controls</button></div>
    </div>

    <div class="tsru-config-section tsru-break-character-section">
      <h3><i class="fas fa-hammer"></i> Break Character</h3><p>Break and Super Break fonts are shared across all characters. Configure them in Module Settings → Break Text Appearance.</p>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Is this a Break Character?</strong><small>Successful attacks deal 1 HP damage and redirect their full rolled damage to Toughness.</small></span><input type="checkbox" name="breakCharacter" {{checked config.breakCharacter}}></div>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Can deal Super Break?</strong><small>While an enemy is broken, each eligible hit rolls one configured Break dice roll plus (Break Effect modifier + 1).</small></span><input type="checkbox" name="superBreakCharacter" {{checked config.superBreakCharacter}}></div>
      <div class="tsru-field"><label><strong>Break Effect score</strong><small>Uses the standard D&amp;D ability-score modifier calculation.</small></label><div class="tsru-field-control"><input type="number" name="breakEffectScore" min="1" max="30" value="{{config.breakEffectScore}}"><span class="tsru-break-modifier">Modifier: {{breakModifierSigned}}</span></div></div>
      <div class="tsru-field"><label><strong>Weakness Break damage</strong><small>When this character reduces Toughness to 0: dice roll × Break Effect modifier (minimum 1).</small></label><div class="tsru-position-control"><select name="breakDamageDice">{{#each breakDiceOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.value}}</option>{{/each}}</select><span>d</span><select name="breakDamageDie">{{#each breakDieOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.value}}</option>{{/each}}</select><span>× modifier</span></div></div>
    </div>

    <div class="tsru-config-section">
      <h3><i class="fas fa-battery-three-quarters"></i> Energy</h3>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Enable Ultimate system</strong><small>Allows this character to gain Energy and display an orb.</small></span><input type="checkbox" name="enabled" {{checked config.enabled}}></div>
      <div class="tsru-field"><label><strong>Current Energy</strong><small>The amount currently stored.</small></label><input type="number" name="current" min="0" value="{{config.current}}"></div>
      <div class="tsru-field"><label><strong>Maximum Energy</strong><small>The amount required to make the Ultimate ready.</small></label><input type="number" name="max" min="1" value="{{config.max}}"></div>
      <div class="tsru-field"><label><strong>Energy Regen score</strong><small>Uses the normal D&amp;D ability-score modifier calculation.</small></label><div class="tsru-field-control"><input type="number" name="regenScore" value="{{config.regenScore}}"><span class="tsru-modifier">Modifier: {{modifierSigned}}</span></div></div>
      <div class="tsru-field"><label><strong>Energy gained when attacking</strong><small>Base gain before the Energy Regen modifier.</small></label><input type="number" name="attackGain" min="0" value="{{config.attackGain}}"></div>
      <div class="tsru-field"><label><strong>Energy gained when attacked</strong><small>Base gain before the Energy Regen modifier.</small></label><input type="number" name="attackedGain" min="0" value="{{config.attackedGain}}"></div>
      <div class="tsru-field"><label><strong>Count as attacked when</strong><small>Choose whether targeting alone is enough.</small></label><select name="attackedMode"><option value="hit" {{#if modeHit}}selected{{/if}}>The attack hits</option><option value="targeted" {{#if modeTargeted}}selected{{/if}}>The character is targeted</option></select></div>
    </div>

    <div class="tsru-config-section tsru-skill-config-section">
      <h3><i class="fas fa-hand-sparkles"></i> Skill</h3>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Enable Skill button</strong><small>Shows this character's movable Skill button to its owner and the GM.</small></span><input type="checkbox" name="skillEnabled" {{checked config.skillEnabled}}></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Skill Text</strong><small>Posted to chat when the Skill button spends its configured shared Skill Point cost. This is descriptive text, not JavaScript.</small></label><textarea name="skillText" rows="7" placeholder="Describe this character's Skill.">{{config.skillText}}</textarea></div>
      <div class="tsru-field"><label><strong>Skill Point Cost</strong><small>Shared Skill Points consumed when this Skill is used. Set to 0 for a free Skill.</small></label><input type="number" name="skillPointCost" min="0" step="1" value="{{config.skillPointCost}}"></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Skill button artwork</strong><small>Displayed inside this character's free-floating circular Skill button. Defaults to the actor portrait.</small></label><div class="tsru-file-control"><input type="text" name="skillButtonImage" value="{{config.skillButtonImage}}" placeholder="Use actor portrait"><button type="button" class="file-picker" data-type="image" data-target="skillButtonImage" title="Browse Files"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Floating Skill button</strong><small>The party must have at least 1 shared Skill Point before it can be pressed.</small></label><button type="button" data-action="show-skill-button"><i class="fas fa-hand-sparkles"></i> Show Skill Button</button></div>
    </div>

    <div class="tsru-config-section tsru-technique-config-section">
      <h3><i class="fas fa-bolt"></i> Technique</h3>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Enable Technique button</strong><small>Shows this character in the shared Technique Point panel for its owner and the GM while outside combat.</small></span><input type="checkbox" name="techniqueEnabled" {{checked config.techniqueEnabled}}></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Technique information</strong><small>Posted to chat when the character spends 1 shared Technique Point. Techniques are blocked whenever initiative is active.</small></label><textarea name="techniqueText" rows="7" placeholder="Describe this character's Technique.">{{config.techniqueText}}</textarea></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Technique button artwork</strong><small>Displayed in the floating Technique panel. Defaults to the actor portrait.</small></label><div class="tsru-file-control"><input type="text" name="techniqueButtonImage" value="{{config.techniqueButtonImage}}" placeholder="Use actor portrait"><button type="button" class="file-picker" data-type="image" data-target="techniqueButtonImage" title="Browse Files"><i class="fas fa-file-import"></i></button></div></div>
    </div>

    <div class="tsru-config-section tsru-talent-config-section">
      <h3><i class="fas fa-star"></i> Talent</h3>
      <div class="tsru-field tsru-field-wide"><label><strong>Talent HUD icon</strong><small>Displayed beneath this character's combat portrait whenever a Talent is configured.</small></label><div class="tsru-file-control"><input type="text" name="talentIcon" value="{{config.talentIcon}}" placeholder="Choose a Talent icon"><button type="button" class="file-picker" data-type="image" data-target="talentIcon" title="Browse Files"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field"><label><strong>Current Talent Points</strong><small>Talent Points currently held. This resets to 0 when combat starts.</small></label><input type="number" name="talentPointsCurrent" min="0" max="{{config.talentPointsOvercapMax}}" step="1" value="{{config.talentPointsCurrent}}"></div>
      <div class="tsru-field"><label><strong>Talent Trigger</strong><small>At this denominator, a TALENT turn is queued after the current turn ends.</small></label><input type="number" name="talentPointsMax" min="0" step="1" value="{{config.talentPointsMax}}"></div>
      <div class="tsru-field"><label><strong>Talent Overcap Maximum</strong><small>The highest numerator this character may store. It cannot be lower than the trigger.</small></label><input type="number" name="talentPointsOvercapMax" min="0" step="1" value="{{config.talentPointsOvercapMax}}"></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Talent Ability Text</strong><small>Shown in the Talent popup, tooltip, and chat when the temporary Talent turn begins.</small></label><textarea name="talentText" rows="8" placeholder="Describe this character's Talent.">{{config.talentText}}</textarea></div>
    </div>

    {{#if elationEnabled}}
    <div class="tsru-config-section tsru-punchline-character-section">
      <h3><i class="fas fa-masks-theater"></i> Elation &amp; Punchline</h3>
      <div class="tsru-field"><label><strong>Punchline Gain</strong><small>If this character has the configured Elation Path, this many Punchlines are gained whenever they inflict damage. Characters on other Paths always generate +1.</small></label><input type="number" name="punchlineGain" min="0" step="1" value="{{config.punchlineGain}}"></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Elation Action Text</strong><small>Posted to chat when this character's temporary Elation Action turn begins. The temporary turns are still inserted and advanced automatically.</small></label><textarea name="elationActionText" rows="7" placeholder="Describe this character's Elation Action.">{{config.elationActionText}}</textarea></div>
    </div>
    {{/if}}

    <div class="tsru-config-section tsru-energy-override">
      <h3><i class="fas fa-gauge-high"></i> Manual Energy Override</h3>
      <div class="tsru-field tsru-field-wide"><label><strong>Set current Energy immediately</strong><small>Overrides this character's current Energy without changing any other settings.</small></label><div class="tsru-override-control"><input type="number" class="tsru-energy-override-value" min="0" max="{{config.max}}" value="{{config.current}}"><button type="button" data-action="set-energy"><i class="fas fa-check"></i> Set Energy</button></div></div>
    </div>

    <div class="tsru-config-section">
      <h3><i class="fas fa-wand-magic-sparkles"></i> Ultimate &amp; Splash Artwork</h3>
      <div class="tsru-field tsru-field-wide"><label><strong>Ultimate Text</strong><small>Posted to chat when the fully charged Ultimate is activated. This is descriptive text, not JavaScript.</small></label><textarea name="ultimateText" rows="7" placeholder="Describe this character's Ultimate.">{{config.ultimateText}}</textarea></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Combat splash artwork</strong><small>Displayed briefly to every connected player.</small></label><div class="tsru-file-control"><input type="text" name="splashImage" value="{{config.splashImage}}" placeholder="Choose an image or video"><button type="button" class="file-picker" data-type="imagevideo" data-target="splashImage" title="Browse Files"><i class="fas fa-file-import"></i></button><button type="button" data-action="preview-splash" title="Preview Splash"><i class="fas fa-eye"></i></button></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Splash artwork crop</strong><small>Drag the artwork in the designer to reposition it, use the mouse wheel to zoom, or drop a new image/video directly onto it.</small></label><div class="tsru-position-control"><span>X</span><input type="number" name="splashX" min="0" max="100" value="{{config.splashX}}"><span>Y</span><input type="number" name="splashY" min="0" max="100" value="{{config.splashY}}"><span>Zoom</span><input type="number" name="splashScale" min="25" max="500" value="{{config.splashScale}}"><span>%</span></div></div>
      <div class="tsru-field"><label><strong>Splash duration</strong><small>How long everyone sees the artwork.</small></label><div class="tsru-unit-control"><input type="number" name="splashDuration" min="0.1" max="30" step="0.1" value="{{config.splashDuration}}"><span>seconds</span></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Ultimate name</strong><small>The large English title displayed over the artwork.</small></label><input type="text" name="ultimateName" value="{{config.ultimateName}}" placeholder="Ultimate name"></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Secondary title</strong><small>Optional smaller text beneath the Ultimate name.</small></label><input type="text" name="ultimateSubtitle" value="{{config.ultimateSubtitle}}" placeholder="Optional translated or stylized title"></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Custom title font</strong><small>Upload or select a TTF, OTF, WOFF, or WOFF2 font stored in Foundry.</small></label><div class="tsru-file-control"><input type="text" name="fontFile" value="{{config.fontFile}}" placeholder="Choose a font file"><button type="button" class="file-picker" data-type="any" data-target="fontFile" title="Browse Files"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Custom secondary-title font</strong><small>Optional separate font for the subtitle. When empty, it uses the main title font.</small></label><div class="tsru-file-control"><input type="text" name="subtitleFontFile" value="{{config.subtitleFontFile}}" placeholder="Use title font"><button type="button" class="file-picker" data-type="any" data-target="subtitleFontFile" title="Browse Files"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field"><label><strong>Title position</strong><small>X and Y are percentages of the screen.</small></label><div class="tsru-position-control"><span>X</span><input type="number" name="titleX" min="0" max="100" value="{{config.titleX}}"><span>Y</span><input type="number" name="titleY" min="0" max="100" value="{{config.titleY}}"></div></div>
      <div class="tsru-field"><label><strong>Title appearance</strong><small>Font size and horizontal alignment.</small></label><div class="tsru-position-control"><input type="number" name="titleSize" min="16" max="140" value="{{config.titleSize}}"><span>px</span><select name="titleAlign"><option value="left" {{#if titleAlignLeft}}selected{{/if}}>Left</option><option value="center" {{#if titleAlignCenter}}selected{{/if}}>Center</option><option value="right" {{#if titleAlignRight}}selected{{/if}}>Right</option></select></div></div>
      <div class="tsru-splash-designer" data-tsru-splash-designer><div class="tsru-splash-designer-media"></div><div class="tsru-title-card"><i class="tsru-title-square tsru-title-square-one"></i><i class="tsru-title-square tsru-title-square-two"></i><div class="tsru-title-copy"><div class="tsru-title-name"></div><div class="tsru-title-bar"><div class="tsru-title-subtitle"></div></div></div></div><span class="tsru-splash-designer-help"><i class="fas fa-hand"></i> Drag artwork · Scroll to zoom · Drop to replace</span></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Title-card preview</strong><small>Uses the current unsaved values and the assigned Element's charging color.</small></label><button type="button" data-action="preview-splash"><i class="fas fa-play"></i> Preview Full Splash</button></div>
    </div>

    <div class="tsru-config-section">
      <h3><i class="fas fa-circle"></i> Floating Ultimate Orb</h3>
      <div class="tsru-field tsru-field-wide"><label><strong>Ultimate button artwork</strong><small>Per-character artwork cropped into this character's circular floating Ultimate button.</small></label><div class="tsru-file-control"><input type="text" name="ultimateButtonImage" value="{{ultimateButtonArtwork}}" placeholder="Use character portrait"><button type="button" class="file-picker" data-type="image" data-target="ultimateButtonImage" title="Browse Files"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Adjust Ultimate artwork?</strong><small>Enables a custom crop and zoom for this character's floating orb and Combat HUD Ultimate icon.</small></span><input type="checkbox" name="ultimateButtonAdjustEnabled" {{checked config.ultimateButtonAdjustEnabled}}></div>
      <div class="tsru-field tsru-field-wide tsru-ultimate-adjust-controls"><label><strong>Ultimate artwork crop</strong><small>Drag the preview to reposition it or use the mouse wheel to zoom.</small></label><div class="tsru-position-control"><span>X</span><input type="number" name="ultimateButtonX" min="0" max="100" value="{{config.ultimateButtonX}}"><span>Y</span><input type="number" name="ultimateButtonY" min="0" max="100" value="{{config.ultimateButtonY}}"><span>Zoom</span><input type="number" name="ultimateButtonScale" min="50" max="400" value="{{config.ultimateButtonScale}}"><span>%</span></div></div>
      <div class="tsru-ultimate-adjust-preview" data-tsru-ultimate-preview><button type="button" tabindex="-1"><span></span><img src="{{ultimateButtonArtwork}}" alt="Ultimate artwork preview"><strong>72%</strong></button></div>
      <div class="tsru-field"><label><strong>Orb colors</strong><small>Charging and Ultimate Ready colors are inherited from the assigned Element.</small></label><div class="tsru-inherited-colors">{{#if selectedElement}}<span style="--swatch: {{selectedElement.chargeColor}}"><i></i> Charging</span><span style="--swatch: {{selectedElement.readyColor}}"><i></i> Ready</span>{{else}}<em>Assign an Element below to choose the orb colors.</em>{{/if}}</div></div>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Show percentage inside orb</strong><small>Displays the current charge as a number.</small></span><input type="checkbox" name="showPercent" {{checked config.showPercent}}></div>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Show charge percentage on Combat HUD</strong><small>Displays this character's current Energy percentage inside their Combat HUD Ultimate orb.</small></span><input type="checkbox" name="showHudPercent" {{checked config.showHudPercent}}></div>
    </div>

    <div class="tsru-config-section tsru-enhanced-stance-section">
      <h3><i class="fas fa-bolt"></i> Enhanced Stance</h3>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Enable enhanced stance controls?</strong><small>Adds an ON/OFF button for this character in the GM panel. The original art returns when the stance is OFF.</small></span><input type="checkbox" name="enhancedStanceEnabled" {{checked config.enhancedStanceEnabled}}></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Enhanced token artwork</strong><small>While Enhanced Stance is ON, each placed token for this character uses this uploaded image. Its previous token image returns when the stance ends. Existing token size and position stay the same.</small></label><div class="tsru-file-control"><input type="text" name="enhancedTokenImage" value="{{config.enhancedTokenImage}}" placeholder="Choose enhanced token artwork"><button type="button" class="file-picker" data-type="image" data-target="enhancedTokenImage" title="Browse Files"><i class="fas fa-file-import"></i></button></div><div class="tsru-enhanced-token-preview" data-enhanced-token-preview><img src="{{#if config.enhancedTokenImage}}{{config.enhancedTokenImage}}{{else}}{{actor.img}}{{/if}}" alt="Enhanced token preview"></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Enter Enhanced Stance GIF</strong><small>Optional animated overlay locked over the token while changing into enhanced form.</small></label><div class="tsru-file-control"><input type="text" name="enhancedTransitionInGif" value="{{config.enhancedTransitionInGif}}" placeholder="No transition GIF"><button type="button" class="file-picker" data-type="image" data-target="enhancedTransitionInGif" title="Browse GIF"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Return to Normal Stance GIF</strong><small>Optional animated overlay locked over the token while restoring its normal artwork.</small></label><div class="tsru-file-control"><input type="text" name="enhancedTransitionOutGif" value="{{config.enhancedTransitionOutGif}}" placeholder="No transition GIF"><button type="button" class="file-picker" data-type="image" data-target="enhancedTransitionOutGif" title="Browse GIF"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field"><label><strong>Token transition length</strong><small>How long each GIF plays before the token artwork changes.</small></label><div class="tsru-unit-control"><input type="number" name="enhancedTransitionDuration" min="0.2" max="15" step="0.1" value="{{config.enhancedTransitionDuration}}"><span>seconds</span></div></div>
      <button type="button" data-action="open-enhanced-hud-editor"><i class="fas fa-up-right-from-square"></i> Design Enhanced Combat HUD Portrait</button>
      <div class="tsru-field tsru-field-wide"><label><strong>Enhanced Combat HUD portrait</strong></label><div class="tsru-file-control"><input type="text" name="enhancedHudPortrait" value="{{config.enhancedHudPortrait}}" placeholder="Keep normal portrait"><button type="button" class="file-picker" data-type="image" data-target="enhancedHudPortrait"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Enhanced Skill button art</strong></label><div class="tsru-file-control"><input type="text" name="enhancedSkillButtonImage" value="{{config.enhancedSkillButtonImage}}" placeholder="Keep normal Skill art"><button type="button" class="file-picker" data-type="image" data-target="enhancedSkillButtonImage"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Enhanced Skill description</strong><small>Required to use Skill while enhanced; the regular Skill stays exclusive to normal stance.</small></label><textarea name="enhancedSkillText" rows="4" placeholder="Describe the enhanced Skill">{{config.enhancedSkillText}}</textarea></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Enhanced Talent icon</strong></label><div class="tsru-file-control"><input type="text" name="enhancedTalentIcon" value="{{config.enhancedTalentIcon}}" placeholder="Keep normal Talent art"><button type="button" class="file-picker" data-type="image" data-target="enhancedTalentIcon"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field tsru-field-wide"><label><strong>Enhanced Talent description</strong><small>Required to use Talent while enhanced; the regular Talent stays exclusive to normal stance.</small></label><textarea name="enhancedTalentText" rows="4" placeholder="Describe the enhanced Talent">{{config.enhancedTalentText}}</textarea></div>
      <button type="button" data-action="open-enhanced-initiative-editor"><i class="fas fa-up-right-from-square"></i> Design Enhanced Initiative Portrait</button>
      <div class="tsru-field tsru-field-wide"><label><strong>Enhanced initiative tracker portrait</strong></label><div class="tsru-file-control"><input type="text" name="enhancedCarouselImage" value="{{config.enhancedCarouselImage}}" placeholder="Keep normal initiative art"><button type="button" class="file-picker" data-type="image" data-target="enhancedCarouselImage"><i class="fas fa-file-import"></i></button></div></div>
      <div class="tsru-field tsru-field-toggle"><span class="tsru-field-label"><strong>Enhance Ultimate?</strong><small>Unlocks separate splash, orb, and Ultimate descriptions for the active stance.</small></span><input type="checkbox" name="enhancedUltimateEnabled" {{checked config.enhancedUltimateEnabled}}></div>
      <div class="tsru-enhanced-ultimate-fields" {{#unless config.enhancedUltimateEnabled}}hidden{{/unless}}>
        <button type="button" data-action="open-enhanced-splash-editor"><i class="fas fa-up-right-from-square"></i> Design Enhanced Ultimate Splash</button>
        <div class="tsru-field tsru-field-wide"><label><strong>Enhanced Ultimate splash art</strong></label><div class="tsru-file-control"><input type="text" name="enhancedSplashImage" value="{{config.enhancedSplashImage}}" placeholder="Keep normal splash"><button type="button" class="file-picker" data-type="imagevideo" data-target="enhancedSplashImage"><i class="fas fa-file-import"></i></button></div></div>
        <div class="tsru-field tsru-field-wide"><label><strong>Enhanced Ultimate orb art</strong></label><div class="tsru-file-control"><input type="text" name="enhancedUltimateButtonImage" value="{{config.enhancedUltimateButtonImage}}" placeholder="Keep normal orb"><button type="button" class="file-picker" data-type="image" data-target="enhancedUltimateButtonImage"><i class="fas fa-file-import"></i></button></div></div>
        <div class="tsru-field tsru-field-wide"><label><strong>Enhanced Ultimate description</strong><small>Replaces the ordinary Ultimate description while the stance is active.</small></label><textarea name="enhancedUltimateText" rows="5" placeholder="Keep normal Ultimate description">{{config.enhancedUltimateText}}</textarea></div>
        <div class="tsru-field tsru-field-wide"><label><strong>Enhanced effect in chat</strong><small>Added below the Ultimate description when it is used in enhanced stance.</small></label><textarea name="enhancedEffectText" rows="5" placeholder="Describe the enhanced effect">{{config.enhancedEffectText}}</textarea></div>
      </div>
    </div>

    <div class="tsru-config-section">
      <h3><i class="fas fa-compass"></i> Element &amp; Path</h3>
      <div class="tsru-field tsru-field-wide"><label><strong>Assigned Element</strong><small>Elements are created from the module settings.</small></label><select name="elementId"><option value="">— None —</option>{{#each elements}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}</select></div>
      {{#if selectedElement}}<div class="tsru-element-preview" style="--element-color: {{selectedElement.color}}"><img src="{{selectedElement.icon}}"><span>{{selectedElement.name}}</span></div>{{/if}}
      <div class="tsru-field tsru-field-wide"><label><strong>Assigned Path</strong><small>Paths are created from Manage Paths in the module settings.</small></label><select name="pathId"><option value="">— None —</option>{{#each paths}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}</select></div>
      {{#if selectedPath}}<div class="tsru-element-preview tsru-path-preview"><img src="{{selectedPath.icon}}"><span>{{selectedPath.name}}</span></div>{{/if}}
    </div>

    <footer class="tsru-sheet-actions">
      <button type="button" data-action="reset-energy"><i class="fas fa-battery-empty"></i> Empty Energy</button>
      <button type="button" data-action="fill-energy"><i class="fas fa-battery-full"></i> Fill Energy</button>
      <button type="button" data-action="show-orb"><i class="fas fa-circle"></i> Show Ultimate Orb</button>
      <button type="button" data-action="show-skill-button"><i class="fas fa-hand-sparkles"></i> Show Skill</button>
      <button type="button" class="tsru-save-config" data-action="save-config"><i class="fas fa-save"></i> Save Configuration</button>
    </footer>
  </div>
</section>
