<div class="tsru-crafting-app">
  <header><div><h2><i class="fas fa-hammer"></i> Party Crafting</h2><p>Ingredients are pooled from every character marked “Is in the Main Party?”</p></div><button type="button" data-action="check-reagents"><i class="fas fa-magnifying-glass"></i> Check Party Reagents</button></header>
  {{#if cards.length}}<section class="tsru-recipe-cards"><h3>Recipe Cards</h3>{{#each cards}}<article><img src="{{this.img}}"><span><strong>{{this.name}}</strong><small>{{this.actorName}} · {{this.quantity}} card(s)</small></span><button type="button" data-action="redeem-card" data-actor-id="{{this.actorId}}" data-item-id="{{this.itemId}}"><i class="fas fa-book-open"></i> Redeem</button></article>{{/each}}</section>{{/if}}
  <div class="tsru-crafting-recipes">
    {{#each recipes}}<article class="tsru-crafting-recipe">
      <header><img src="{{this.img}}"><div><h3>{{this.name}}</h3><p>{{this.description}}</p></div>{{#if this.output}}<span class="tsru-crafting-yield"><img src="{{this.output.img}}"><b>×{{this.output.quantity}}</b></span>{{/if}}</header>
      <div class="tsru-crafting-ingredients">{{#each this.ingredients}}<div class="{{#if this.enough}}enough{{else}}missing{{/if}}"><img src="{{this.img}}"><span><strong>{{this.name}}</strong><small>Required {{this.quantity}}{{#if @root.inventoryChecked}} · Party has {{this.available}}{{/if}}</small></span><div><button type="button" data-place-delta="-1" data-recipe-id="{{../id}}" data-ingredient-key="{{this.key}}"><i class="fas fa-minus"></i></button><b>{{this.placed}} / {{this.quantity}}</b><button type="button" data-place-delta="1" data-recipe-id="{{../id}}" data-ingredient-key="{{this.key}}"><i class="fas fa-plus"></i></button></div></div>{{else}}<em>No ingredients required.</em>{{/each}}</div>
      <footer><button type="button" data-action="auto-place" data-recipe-id="{{this.id}}"><i class="fas fa-wand-magic-sparkles"></i> Auto Place</button><select data-recipe-recipient="{{this.id}}"><option value="">Receive crafted item…</option>{{#each ../actors}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}</select><button type="button" data-action="craft" data-recipe-id="{{this.id}}" {{#unless this.placedReady}}disabled{{/unless}}><i class="fas fa-hammer"></i> Craft</button></footer>
    </article>{{else}}<p class="notes">No crafting recipes have been unlocked yet. Find and redeem a recipe card.</p>{{/each}}
  </div>
</div>
