<form class="tsru-blow-up-tatsuo">
  <p>Choose a player. The animation plays over every placed character token they own on each connected viewer's active scene.</p>
  <div class="form-group"><label for="tsru-blast-player">Player</label><select id="tsru-blast-player" name="playerId"><option value="">Choose a player</option>{{#each players}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
  <div class="form-group"><label for="tsru-blast-gif">Animated GIF or WebP</label><div class="tsru-file-control"><input id="tsru-blast-gif" type="text" name="gif" value="{{config.gif}}" placeholder="Select an animation"><button type="button" data-tsru-blast-browse title="Browse files"><i class="fas fa-file-import"></i></button></div></div>
  <p class="notes">Preview token: <span data-tsru-blast-count>Select a player</span>. Drag the animation to position it; scroll to resize it; drop a GIF or WebP to replace it. At 100%, the animation matches the token's dimensions.</p>
  <div class="tsru-transition-stage tsru-blast-stage" data-tsru-blast-stage><img class="tsru-transition-token" alt="Owned character token"><img class="tsru-transition-overlay" src="{{config.gif}}" alt="Animation preview"></div>
  <div class="tsru-transition-controls"><label>X offset (%) <input type="number" name="x" min="-300" max="300" step="1" value="{{config.x}}"></label><label>Y offset (%) <input type="number" name="y" min="-300" max="300" step="1" value="{{config.y}}"></label><label>Size (%) <input type="number" name="scale" min="10" max="500" step="1" value="{{config.scale}}"></label></div>
  <div class="tsru-transition-controls"><label>Hue shift (°) <input type="number" name="hue" min="-180" max="180" step="1" value="{{config.hue}}"></label><label>Saturation (%) <input type="number" name="saturation" min="0" max="300" step="1" value="{{config.saturation}}"></label><label>Brightness (%) <input type="number" name="brightness" min="0" max="300" step="1" value="{{config.brightness}}"></label><label>Duration (seconds) <input type="number" name="duration" min="0.2" max="15" step="0.1" value="{{config.duration}}"></label></div>
  <div class="tsru-blast-actions"><button type="submit"><i class="fas fa-floppy-disk"></i> Save Settings</button><button type="button" data-tsru-blast-trigger><i class="fas fa-bomb"></i> Blow Up Tatsuo</button></div>
</form>
