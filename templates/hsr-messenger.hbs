<main class="tsru-messenger">
  <aside class="tsru-messenger-sidebar">
    <header><h2><i class="fas fa-comments"></i> Messenger</h2><button type="button" data-action="new-thread" title="{{#if isGM}}Make Group Chat{{else}}Open Contacts{{/if}}"><i class="fas {{#if isGM}}fa-users-plus{{else}}fa-address-book{{/if}}"></i>{{#if isGM}} Make Group Chat{{/if}}</button></header>
    <nav class="tsru-messenger-tabs"><button type="button" class="{{#if messagesView}}active{{/if}}" data-messenger-view="messages"><i class="fas fa-message"></i> Messages</button><button type="button" class="{{#if contactsView}}active{{/if}}" data-messenger-view="contacts"><i class="fas fa-address-book"></i> Contacts</button></nav>
    <div class="tsru-messenger-thread-list">{{#each threads}}<button type="button" class="{{#if this.selected}}active{{/if}}" data-thread-id="{{this.id}}"><strong>{{this.title}}</strong><small>{{this.preview}}</small></button>{{else}}<p>No text chains yet.</p>{{/each}}</div>
  </aside>
  {{#if contactsView}}
    <section class="tsru-messenger-contacts"><header><div><h2><i class="fas fa-address-book"></i> Contacts</h2><small>Available characters</small></div>{{#if isGM}}<button type="button" data-action="configure-contacts"><i class="fas fa-user-gear"></i> Configure Contacts</button>{{/if}}</header><label class="tsru-contact-search"><i class="fas fa-search"></i><input type="search" data-contact-search placeholder="Search contacts…"></label><div class="tsru-contact-grid">{{#each contacts}}<button type="button" data-contact-id="{{this.id}}" data-contact-name="{{this.name}}"><img src="{{this.portrait}}" alt=""><span><strong>{{this.name}}</strong><small>Start a conversation</small></span></button>{{else}}<p class="empty">No contacts are currently available.</p>{{/each}}</div></section>
  {{else}}
    <section class="tsru-messenger-conversation">
      {{#if selected}}
        <header><div><h2>{{selected.title}}</h2><small>{{selected.participantNames}}</small></div>{{#if isGM}}<button type="button" data-action="delete-thread" title="Delete text chain"><i class="fas fa-trash"></i></button>{{/if}}</header>
        <div class="tsru-messenger-messages">{{#each selected.messages}}<article class="{{#if this.mine}}mine{{/if}}"><img src="{{this.portrait}}" alt="" style="--msg-x:{{this.portraitX}}%;--msg-y:{{this.portraitY}}%;--msg-scale:{{this.portraitScale}};"><div><header><b>{{this.speakerName}}</b>{{#if ../isGM}}<button type="button" data-delete-message="{{this.id}}" title="Delete this message"><i class="fas fa-trash"></i></button>{{/if}}</header><p>{{this.text}}</p><time>{{this.time}}</time></div></article>{{else}}<p class="empty">This text chain has no messages yet.</p>{{/each}}</div>
        <footer>{{#if isGM}}<label>Talking as<select name="speakerActorId">{{#each speakers}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}</select></label>{{/if}}<textarea name="messageText" rows="2" placeholder="Enter message"></textarea><button type="button" data-action="send-message"><i class="fas fa-paper-plane"></i> Send</button></footer>
      {{else}}<div class="tsru-messenger-empty"><i class="fas fa-message"></i><p>Select a text chain{{#if isGM}} or make a group chat{{else}} or choose a contact{{/if}}.</p></div>{{/if}}
    </section>
  {{/if}}
</main>
