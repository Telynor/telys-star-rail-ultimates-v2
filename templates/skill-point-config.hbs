<form class="tsru-skill-point-config">
  <p>Configure the party-wide Honkai: Star Rail Skill Point pool. The active GM authorizes every spend.</p>
  <fieldset>
    <legend>Shared Pool</legend>
    <div class="form-group"><label>Maximum Skill Points</label><div class="form-fields"><input type="number" name="maximum" min="1" step="1" value="{{config.maximum}}"></div></div>
    <div class="form-group"><label>Points at Combat Start</label><div class="form-fields"><input type="number" name="starting" min="0" step="1" value="{{config.starting}}"></div></div>
    <div class="form-group"><label>Current Skill Points</label><div class="form-fields"><input type="number" name="current" min="0" step="1" value="{{current}}"></div></div>
    <div class="form-group"><label>Points per Row</label><div class="form-fields"><input type="number" name="pointsPerRow" min="1" step="1" value="{{config.pointsPerRow}}"></div><p class="notes">Rows drain from right to left, starting with the top row.</p></div>
  </fieldset>
  <fieldset>
    <legend>Point Artwork</legend>
    <div class="form-group"><label>Illuminated Skill Point</label><div class="form-fields tsru-file-control"><input class="tsru-drop-image" type="text" name="illuminatedIcon" value="{{config.illuminatedIcon}}"><button type="button" class="file-picker" data-target="illuminatedIcon"><i class="fas fa-file-import"></i></button></div></div>
    <div class="form-group"><label>Empty Skill Point</label><div class="form-fields tsru-file-control"><input class="tsru-drop-image" type="text" name="emptyIcon" value="{{config.emptyIcon}}"><button type="button" class="file-picker" data-target="emptyIcon"><i class="fas fa-file-import"></i></button></div></div>
  </fieldset>
  <div class="tsru-manager-actions">
    <button type="button" data-action="show-skill-ui"><i class="fas fa-eye"></i> Show Meter &amp; Buttons</button>
    <button type="button" data-action="refill-skill-points"><i class="fas fa-battery-full"></i> Fill Pool</button>
    <button type="submit"><i class="fas fa-save"></i> Save</button>
  </div>
</form>
