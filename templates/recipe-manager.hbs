<form class="tsru-recipe-browser">
  <header><div><h2><i class="fas fa-hammer"></i> Crafting Recipes</h2><p>{{total}} recipes · Toggle party access here; select a recipe to edit it. Existing recipe unlocks are preserved.</p></div><button type="button" data-new-recipe><i class="fas fa-plus"></i> New Recipe</button></header>
  <label class="tsru-recipe-browser-search"><i class="fas fa-magnifying-glass"></i><input type="search" data-recipe-search placeholder="Search recipes, categories, or descriptions" autocomplete="off"></label>
  <div class="tsru-recipe-browser-list">{{#each recipes}}<div class="tsru-recipe-browser-row" data-recipe-row data-search="{{this.searchText}}"><button type="button" data-open-recipe="{{this.id}}"><img src="{{this.output.img}}" alt=""><span><strong>{{this.name}}</strong><small>{{this.categoryName}} · {{this.ingredientCount}} ingredients · {{this.outputName}}</small></span><i class="fas fa-chevron-right"></i></button><label class="tsru-recipe-party-toggle" title="Allow party members with this recipe unlocked to see and craft it"><input type="checkbox" data-recipe-party-toggle="{{this.id}}" {{#if this.partyAvailable}}checked{{/if}}><span>Party access</span></label></div>{{else}}<div class="tsru-empty-state"><i class="fas fa-hammer"></i><p>No recipes yet. Create one to start crafting.</p></div>{{/each}}</div>
</form>
