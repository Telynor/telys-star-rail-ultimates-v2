<form class="tsru-recipe-browser">
  <header><div><h2><i class="fas fa-hammer"></i> Crafting Recipes</h2><p>{{total}} recipes · Select one to view or edit its ingredients and result.</p></div><button type="button" data-new-recipe><i class="fas fa-plus"></i> New Recipe</button></header>
  <label class="tsru-recipe-browser-search"><i class="fas fa-magnifying-glass"></i><input type="search" data-recipe-search placeholder="Search recipes, categories, or descriptions" autocomplete="off"></label>
  <div class="tsru-recipe-browser-list">{{#each recipes}}<button type="button" data-recipe-row data-search="{{this.searchText}}" data-open-recipe="{{this.id}}"><img src="{{this.output.img}}" alt=""><span><strong>{{this.name}}</strong><small>{{this.categoryName}} · {{this.ingredientCount}} ingredients · {{this.outputName}}</small></span><i class="fas fa-chevron-right"></i></button>{{else}}<div class="tsru-empty-state"><i class="fas fa-hammer"></i><p>No recipes yet. Create one to start crafting.</p></div>{{/each}}</div>
</form>
