<form class="tsru-classification-manager">
  <header><div><h2><i class="fas fa-layer-group"></i> Crafting Classifications</h2><p>These classifications become tabs in Party Crafting and can be assigned to recipes.</p></div><button type="button" data-action="add-classification"><i class="fas fa-plus"></i> Add</button></header>
  <div class="tsru-classification-list">
    {{#each classifications}}<div data-classification-row>
      <i class="{{this.icon}} tsru-classification-preview"></i>
      <label>Name<input type="text" data-field="name" value="{{this.name}}"></label>
      <label>ID<input type="text" data-field="id" value="{{this.id}}"></label>
      <label>Font Awesome icon<input type="text" data-field="icon" value="{{this.icon}}" placeholder="fas fa-box"></label>
      <button type="button" class="danger" data-action="remove-classification" data-index="{{@index}}"><i class="fas fa-trash"></i></button>
    </div>{{/each}}
  </div>
  <button type="button" class="tsru-save-classifications" data-action="save-classifications"><i class="fas fa-save"></i> Save Classifications</button>
</form>
