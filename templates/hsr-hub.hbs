<main class="tsru-phone-hub" style="--hub-wallpaper:url('{{config.wallpaper}}');--hub-wallpaper-fit:{{config.wallpaperFit}};--hub-wallpaper-x:{{config.wallpaperX}}%;--hub-wallpaper-y:{{config.wallpaperY}}%;--hub-wallpaper-scale:{{config.wallpaperScale}};">
  <button type="button" class="tsru-phone-close" data-action="close-phone-hub" aria-label="Close HSR Hub"><i class="fas fa-xmark"></i></button>
  {{#unless gmPanel}}<section class="tsru-phone-pose" style="--pose-x:{{pose.x}}%;--pose-y:{{pose.y}}%;--pose-scale:{{pose.scale}};--pose-flip:{{#if pose.flip}}-1{{else}}1{{/if}};">
    {{#if actor}}<img src="{{pose.image}}" alt="{{actor.name}} holding their phone"><footer><strong>{{actor.name}}</strong><span>Main Character</span></footer>{{else}}<div class="tsru-phone-no-character"><i class="fas fa-user-slash"></i><b>Select a Main Character</b></div>{{/if}}
  </section>{{/unless}}
  <section class="tsru-phone-screen"><div class="tsru-phone-wallpaper"></div><header><small>UID {{#if actor}}{{actor.id}}{{else}}—{{/if}}</small>{{#if gm}}<div class="tsru-gm-phone-switch"><select data-gm-phone-view>{{#each phoneChoices}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}</select><button type="button" data-action="configure-viewed-phone"><i class="fas fa-pen-ruler"></i> Configure</button></div>{{/if}}<div>{{#if actor}}<img src="{{actor.img}}" alt=""><span><strong>{{actor.name}}</strong><small>Trailblazer Terminal</small></span>{{else}}{{#if gmPanel}}<span><strong>DM PANEL</strong><small>Game Master Terminal</small></span>{{/if}}{{/if}}</div></header><div class="tsru-phone-button-field">{{#each buttons}}<button type="button" class="{{#if this.gmOnly}}tsru-phone-button-gm{{/if}}" data-hub-action="{{this.action}}" data-hub-button-id="{{this.id}}" style="{{this.style}}"><i class="{{this.icon}}"></i><span>{{this.label}}</span></button>{{/each}}</div></section>
</main>
