<form class="tsru-break-appearance-form">
  <h2>Universal Break Text Fonts</h2>
  <p>These fonts apply to every character's floating Break and Super Break text. Leave a field empty to use the default font. Supports TTF, OTF, and WOFF files.</p>
  <div class="tsru-field"><label for="tsru-break-font"><strong>Break font</strong></label><div class="tsru-file-control"><input id="tsru-break-font" name="breakFontFile" value="{{config.breakFontFile}}" placeholder="Default font"><button type="button" class="file-picker" data-target="breakFontFile" title="Browse font files"><i class="fas fa-file-import"></i></button></div></div>
  <div class="tsru-field"><label for="tsru-super-break-font"><strong>Super Break font</strong></label><div class="tsru-file-control"><input id="tsru-super-break-font" name="superBreakFontFile" value="{{config.superBreakFontFile}}" placeholder="Default font"><button type="button" class="file-picker" data-target="superBreakFontFile" title="Browse font files"><i class="fas fa-file-import"></i></button></div></div>
  <footer><button type="submit"><i class="fas fa-save"></i> Save Shared Fonts</button></footer>
</form>
