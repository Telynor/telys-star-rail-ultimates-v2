<form class="tsru-frame-color-manager">
  <header><h2><i class="fas fa-palette"></i> Initiative Tracker Frame Colors</h2><p>Create reusable colors here. Characters inherit the current value of their selected color automatically.</p></header>
  <div class="tsru-frame-color-list">
    {{#each colors}}
    <div class="tsru-frame-color-row" data-color-index="{{@index}}">
      <input type="hidden" name="colors.{{@index}}.id" value="{{this.id}}">
      <input type="text" name="colors.{{@index}}.name" value="{{this.name}}" placeholder="Color name">
      <input type="color" name="colors.{{@index}}.color" value="{{this.color}}" title="Frame color">
      <button type="button" data-action="remove-frame-color" title="Remove color"><i class="fas fa-trash"></i></button>
    </div>
    {{/each}}
  </div>
  <div class="tsru-frame-color-actions"><button type="button" data-action="add-frame-color"><i class="fas fa-plus"></i> Add Color</button><button type="submit"><i class="fas fa-save"></i> Save Colors</button></div>
</form>
